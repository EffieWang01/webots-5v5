<!-- game play -->

<root BTCPP_format="4">
    <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />
    <include path="./subtrees/subtree_striker_play.xml" />
    <include path="./subtrees/subtree_goal_keeper_play.xml" />
    <include path="./subtrees/subtree_defender_play.xml" />
    <include path="./subtrees/subtree_striker_freekick.xml" />
    <include path="./subtrees/subtree_goal_keeper_freekick.xml" />
    <include path="./subtrees/subtree_locate.xml" />
    <include path="./subtrees/subtree_auto_standup_and_locate.xml" />
    <BehaviorTree ID="MainTree">
        <Sequence name="root">
            <!-- Enter kSoccer once at startup (same as former RunOnce RobocupWalk); keep control_state=3 -->
            <RunOnce>
                <Sequence>
                    <Script code="control_state=3" />
                    <Script code="force_soccer_mode=true" />
                </Sequence>
            </RunOnce>
            <ReactiveSequence _while="control_state==1 || assist_kick || go_manual || assist_chase" >
                <SimpleChase _while="assist_chase" vx_limit="1.5" vy_limit="0.1" stop_dist="0.0" stop_angle="0.3" />
                <Sequence _while="assist_kick">
                    <Kick speed_limit="0.9" min_msec_kick="1000"/>
               </Sequence>
            </ReactiveSequence>

            <ReactiveSequence _while="control_state==2" name="if you need to pickup, go to the field entrance position, then press LT + A, recalibrate and locate, wait for a few seconds, then press LT + B to continue">
                <!-- Enter kSoccer once per locate (force_soccer_mode set by agent/joystick); then stand still and only scan head -->
                <RobocupWalk _while="force_soccer_mode" />
                <SetVelocity />
                <CamScanField _while="!odom_calibrated"
                              low_pitch="0.60" high_pitch="0.45"
                              left_yaw="1.1" right_yaw="-1.1"
                              msec_cycle="8000"/>
                <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                <SelfLocateEnterField />
            </ReactiveSequence>

            <ReactiveSequence _while="control_state==3 &amp;&amp; (!go_manual)" name="wrap a layer for control strategy switch, 3 is the state of LT+B on the controller, 2 is LT+A, 1 is LT+X">
                <!-- Former RunOnce RobocupWalk: only when force_soccer_mode set at startup / locate -->
                <RobocupWalk _while="force_soccer_mode" />
                <SubTree ID="AutoGetUpAndLocate" _autoremap="true" />
                <ReactiveSequence _while="gc_is_under_penalty" name="currently under penalty or substitute state">
                    <SetVelocity />
                    <CamScanField _while="!odom_calibrated"
                                  low_pitch="0.60" high_pitch="0.45"
                                  left_yaw="1.1" right_yaw="-1.1"
                                  msec_cycle="8000"/>
                    <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                    <SelfLocateEnterField />
                </ReactiveSequence>

                <ReactiveSequence _while="!gc_is_under_penalty" name="no penalty, normal play">
                    <ReactiveSequence _while="gc_game_sub_state_type=='TIMEOUT'" name="game paused. during pause, game state must be INITIAL">
                        <SetVelocity />
                        <CamScanField _while="!odom_calibrated"
                                      low_pitch="0.60" high_pitch="0.45"
                                      left_yaw="1.1" right_yaw="-1.1"
                                      msec_cycle="8000"/>
                        <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                        <SelfLocateEnterField />
                    </ReactiveSequence>

                    <!-- Open play / FK EXECUTE that is not goal-kick or line set-play. -->
                    <ReactiveSequence _while="gc_game_state=='PLAY' &amp;&amp; (gc_game_sub_state_type=='NONE' || (gc_game_sub_state_type=='FREE_KICK' &amp;&amp; local_freekick_use_custom &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; local_freekick_phase=='EXECUTE' &amp;&amp; gc_real_game_sub_state!='GOAL_KICK' &amp;&amp; gc_real_game_sub_state!='THROW_IN' &amp;&amp; gc_real_game_sub_state!='CORNER_KICK'))" name="PlayUnified">
                        <SubTree ID="StrikerPlay" _autoremap="true" _while="player_role == 'striker'" />
                        <SubTree ID="GoalKeeperPlay" _autoremap="true" _while="player_role == 'goal_keeper'" />
                        <SubTree ID="DefenderPlay" _autoremap="true" _while="player_role == 'defender'" />
                    </ReactiveSequence>

                    <!-- Own goal-kick EXECUTE: GK takes; field players stay on freekick support slots. -->
                    <ReactiveSequence _while="gc_game_state=='PLAY' &amp;&amp; gc_game_sub_state_type=='FREE_KICK' &amp;&amp; local_freekick_use_custom &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; local_freekick_phase=='EXECUTE' &amp;&amp; gc_real_game_sub_state=='GOAL_KICK'" name="OwnGoalKickExecute">
                        <SubTree ID="GoalKeeperPlay" _autoremap="true" _while="player_role == 'goal_keeper'" />
                        <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'striker'" />
                        <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'defender'" />
                    </ReactiveSequence>

                    <!-- Own throw-in / corner EXECUTE: only freekick_i_am_taker kicks; others hold support. -->
                    <ReactiveSequence _while="gc_game_state=='PLAY' &amp;&amp; gc_game_sub_state_type=='FREE_KICK' &amp;&amp; local_freekick_use_custom &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; local_freekick_phase=='EXECUTE' &amp;&amp; (gc_real_game_sub_state=='THROW_IN' || gc_real_game_sub_state=='CORNER_KICK')" name="OwnLineSetPlayExecute">
                        <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'striker'" />
                        <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'defender'" />
                        <SubTree ID="GoalKeeperFreekick" _autoremap="true" _while="player_role == 'goal_keeper'"/>
                    </ReactiveSequence>

                    <ReactiveSequence _while="gc_game_sub_state_type=='NONE' &amp;&amp; gc_game_state!='PLAY'" name="normal play">
                        <!-- Original trigger: GC INITIAL only. Improved standstill + scan (same quality as agent locate). -->
                        <ReactiveSequence _while="gc_game_state=='INITIAL'" name="stand at the field entrance position">
                            <SetVelocity />
                            <CamScanField _while="!odom_calibrated"
                                          low_pitch="0.60" high_pitch="0.45"
                                          left_yaw="1.1" right_yaw="-1.1"
                                          msec_cycle="8000"/>
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                            <SelfLocateEnterField />
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='READY'" name="move to own starting position inside the field">
                            <!-- Original: if not calibrated yet, locate before walking -->
                            <ReactiveSequence _while="!odom_calibrated">
                                <SetVelocity />
                                <CamScanField low_pitch="0.60" high_pitch="0.45"
                                              left_yaw="1.1" right_yaw="-1.1"
                                              msec_cycle="8000"/>
                                <SelfLocateEnterField />
                            </ReactiveSequence>
                            <ReactiveSequence _while="odom_calibrated">
                                <MoveHead pitch="0.35" yaw="0.0" />
                                <GoToReadyPosition  vx_limit="0.7" />
                                <SubTree ID="Locate" _autoremap="true" />
                            </ReactiveSequence>
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='SET'" name="stand ready and wait for the game to start">
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                            <SetVelocity />
                            <SubTree ID="Locate" _autoremap="true" />
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='END'" name="game end">
                            <SetVelocity />
                        </ReactiveSequence>

                    </ReactiveSequence>

                    <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_state=='PLAY'" name="free kick">
                        <ReactiveSequence _while="local_freekick_use_custom &amp;&amp; local_freekick_phase!='EXECUTE'">
                            <ReactiveSequence _while="local_freekick_phase=='WAIT_RESUME'">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known"/>
                                <SetVelocity />
                            </ReactiveSequence>
                            <ReactiveSequence _while="local_freekick_phase=='PLACEMENT'">
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                                <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'striker'" />
                                <SubTree ID="GoalKeeperFreekick" _autoremap="true" _while="player_role == 'goal_keeper'"/>
                                <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'defender'"/>
                            </ReactiveSequence>
                            <ReactiveSequence _while="local_freekick_phase=='UNPLACEMENT'">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                                <SetVelocity />
                            </ReactiveSequence>
                        </ReactiveSequence>
                        <!-- Defending team during EXECUTE: keep wall (do not freeze / chase). -->
                        <ReactiveSequence _while="local_freekick_use_custom &amp;&amp; local_freekick_phase=='EXECUTE' &amp;&amp; !gc_is_sub_state_kickoff_side">
                            <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'striker'" />
                            <SubTree ID="GoalKeeperFreekick" _autoremap="true" _while="player_role == 'goal_keeper'"/>
                            <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'defender'"/>
                        </ReactiveSequence>
                        <ReactiveSequence _while="!local_freekick_use_custom">
                            <ReactiveSequence _while="gc_game_sub_state=='STOP'">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known"/>
                                <SetVelocity />
                            </ReactiveSequence>
                            <ReactiveSequence _while="gc_game_sub_state=='GET_READY'">
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                                <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'striker'" />
                                <SubTree ID="GoalKeeperFreekick" _autoremap="true" _while="player_role == 'goal_keeper'"/>
                                <SubTree ID="StrikerFreekick" _autoremap="true" _while="player_role == 'defender'"/>
                            </ReactiveSequence>
                            <ReactiveSequence _while="gc_game_sub_state=='SET'">
                                <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                                <SetVelocity />
                            </ReactiveSequence>
                        </ReactiveSequence>
                    </ReactiveSequence>

                </ReactiveSequence>
            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>
</root>
