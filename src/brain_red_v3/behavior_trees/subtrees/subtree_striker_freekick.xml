<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="StrikerFreekick">
      <ReactiveSequence>
         <ReactiveSequence _while="gc_is_sub_state_kickoff_side" name="move to attacking freekick position">
            <CamTrackBall _while="ball_location_known" />
            <CalcKickDir />
            <SubTree ID="FindBall" _while="!(ball_location_known || tm_ball_pos_reliable)" _autoremap="true" />
            <!-- Placement / non-taker EXECUTE: hold support or approach slot -->
            <GoToFreekickPosition _while="(ball_location_known || tm_ball_pos_reliable) &amp;&amp; (local_freekick_phase!='EXECUTE' || !freekick_i_am_taker)" side="attack" attack_dist="0.50" vx_limit="0.7" vy_limit="0.4" />
            <!-- EXECUTE taker: chase / adjust / kick (do not fall back to open-play PlayUnified) -->
            <ReactiveSequence _while="local_freekick_phase=='EXECUTE' &amp;&amp; freekick_i_am_taker &amp;&amp; (ball_location_known || tm_ball_pos_reliable)">
               <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="0.85" />
               <Chase   _while="decision == 'chase'"  vx_limit="0.85"  vy_limit="0.25"  vtheta_limit="1.0"  dist="0.45" safe_dist="0.70" />
               <Adjust _while="decision =='adjust'" turn_threshold="0.5" range="0.40" vx_limit="0.45" vy_limit="0.35" vtheta_limit="1.2" vtheta_factor="2.0" tangential_speed_far="0.25" tangential_speed_near="0.12" near_threshold="0.35" no_turn_threshold="0.15" turn_first_threshold="0.40" />
               <Kick _while="decision == 'kick'" speed_limit="0.8" min_msec_kick="800" msecs_stablize="400"/>
               <Kick _while="decision == 'cross'" speed_limit="0.4" min_msec_kick="300"/>
            </ReactiveSequence>
         </ReactiveSequence>
         <ReactiveSequence _while="!gc_is_sub_state_kickoff_side" name="move to defending freekick position">
            <CamTrackBall _while="ball_location_known" />
            <CalcKickDir />
            <SubTree ID="FindBall" _while="!(ball_location_known || tm_ball_pos_reliable) &amp;&amp; !(gc_real_game_sub_state=='GOAL_KICK' &amp;&amp; !gc_is_sub_state_kickoff_side)" _autoremap="true" />
            <GoToFreekickPosition _while="ball_location_known || tm_ball_pos_reliable || (gc_real_game_sub_state=='GOAL_KICK' &amp;&amp; !gc_is_sub_state_kickoff_side)" side="defense" />
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
